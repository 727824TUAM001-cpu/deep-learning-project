# Copy this file to .env and fill in your values

# Flask secret key (change this in production!)
SECRET_KEY=pneumonia-ai-secret-2024

# Database URL
# SQLite (default — no setup needed):
DATABASE_URL=sqlite:///database/pneumonia.db

# MySQL (optional — uncomment and fill in):
# DATABASE_URL=mysql+pymysql://root:password@localhost/pneumonia_db

# Admin credentials (used to seed the database on first run)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pneumonia.ai
ADMIN_PASSWORD=Admin@123
